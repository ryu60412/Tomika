<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ミニカーデザイナー</title>

<style>
body{
  margin:0;
  padding:20px;
  font-family:sans-serif;
  background:#f5f5f5;
  text-align:center;
}

h1{
  margin-top:0;
}

#carArea{
  width:320px;
  height:220px;
  margin:20px auto;
  position:relative;
}

#car{
  width:320px;
  height:220px;
  position:relative;
}

#body{
  position:absolute;
  left:35px;
  top:70px;
  width:250px;
  height:80px;
  background:#ff0000;
  border-radius:20px;
  transition:.3s;
}

#roof{
  position:absolute;
  left:95px;
  top:40px;
  width:130px;
  height:45px;
  background:inherit;
  border-radius:20px 20px 0 0;
}

.wheel{
  width:50px;
  height:50px;
  background:#222;
  border-radius:50%;
  position:absolute;
  bottom:20px;
}

.left{
  left:55px;
}

.right{
  right:55px;
}

#namePlate{
  position:absolute;
  width:100%;
  top:100px;
  color:white;
  font-weight:bold;
  pointer-events:none;
}

.sticker{
  position:absolute;
  font-size:32px;
  cursor:grab;
  user-select:none;
}

.controls{
  max-width:320px;
  margin:auto;
  display:flex;
  flex-direction:column;
  gap:12px;
}

button,
select,
input{
  padding:12px;
  font-size:16px;
  border-radius:10px;
  border:1px solid #ccc;
}

@media(max-width:480px){
  #carArea{
    transform:scale(.9);
  }
}
</style>
</head>

<body>

<h1>🚗 ミニカーデザイナー</h1>

<div id="carArea">
  <div id="car">

    <div id="body"></div>
    <div id="roof"></div>

    <div class="wheel left"></div>
    <div class="wheel right"></div>

    <div id="namePlate"></div>

  </div>
</div>

<div class="controls">

  <select id="carType">
    <option value="sport">🏎️ スポーツカー</option>
    <option value="police">🚓 パトカー</option>
    <option value="fire">🚒 消防車</option>
    <option value="bus">🚌 バス</option>
  </select>

  <input
    type="color"
    id="colorPicker"
    value="#ff0000"
  >

  <input
    type="text"
    id="nameInput"
    placeholder="車の名前"
  >

  <button id="starBtn">
    ⭐ ステッカー追加
  </button>

</div>

<script>
const body = document.getElementById("body");
const roof = document.getElementById("roof");
const namePlate = document.getElementById("namePlate");
const colorPicker = document.getElementById("colorPicker");
const nameInput = document.getElementById("nameInput");
const carType = document.getElementById("carType");
const starBtn = document.getElementById("starBtn");
const car = document.getElementById("car");

colorPicker.addEventListener("input", () => {
  body.style.background = colorPicker.value;
  roof.style.background = colorPicker.value;
});

nameInput.addEventListener("input", () => {
  namePlate.textContent = nameInput.value;
});

function changeCar(type){

  if(type==="sport"){
    body.style.width="250px";
    body.style.height="80px";
    body.style.left="35px";
    body.style.top="70px";
    body.style.borderRadius="20px";

    roof.style.width="130px";
    roof.style.height="45px";
    roof.style.left="95px";
    roof.style.top="40px";
  }

  if(type==="police"){
    body.style.width="250px";
    body.style.height="80px";
    body.style.left="35px";
    body.style.top="70px";
    body.style.borderRadius="12px";

    roof.style.width="120px";
    roof.style.height="45px";
    roof.style.left="100px";
    roof.style.top="40px";

    body.style.background="#ffffff";
    roof.style.background="#ffffff";
  }

  if(type==="fire"){
    body.style.width="260px";
    body.style.height="90px";
    body.style.left="30px";
    body.style.top="65px";
    body.style.borderRadius="10px";

    roof.style.width="110px";
    roof.style.height="40px";
    roof.style.left="100px";
    roof.style.top="45px";

    body.style.background="#d50000";
    roof.style.background="#d50000";
  }

  if(type==="bus"){
    body.style.width="280px";
    body.style.height="100px";
    body.style.left="20px";
    body.style.top="55px";
    body.style.borderRadius="10px";

    roof.style.width="0";
    roof.style.height="0";

    body.style.background="#ffd600";
    roof.style.background="#ffd600";
  }
}

carType.addEventListener("change", () => {
  changeCar(carType.value);
});

starBtn.addEventListener("click", () => {

  const s = document.createElement("div");
  s.className = "sticker";
  s.textContent = "⭐";

  s.style.left =
    Math.random() * 240 + "px";

  s.style.top =
    Math.random() * 120 + "px";

  car.appendChild(s);

  let move = false;

  s.addEventListener("touchstart",()=>{
    move = true;
  });

  s.addEventListener("touchmove",(e)=>{
    if(!move) return;

    const rect =
      car.getBoundingClientRect();

    const x =
      e.touches[0].clientX
      - rect.left;

    const y =
      e.touches[0].clientY
      - rect.top;

    s.style.left = x + "px";
    s.style.top = y + "px";
  });

  s.addEventListener("touchend",()=>{
    move = false;
  });

});

changeCar("sport");
</script>

</body>
</html>
